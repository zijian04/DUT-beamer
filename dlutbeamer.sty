%% DLUT Beamer Theme (Modernised, minimal blue)
%%
%% A minimalist defence theme inspired by the FDU "搜索策略" slides.
%% Design principles:
%%   - No top accent bar; frame titles are plain coloured text only.
%%   - Soft blue palette, used sparingly.
%%   - Four-segment gradient footer with author / title / date / page.
%%   - Compact, restrained typography throughout.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{dlutbeamer}[2026/05/30 Modernised DLUT defence beamer theme]

\RequirePackage{tikz}
\RequirePackage{graphicx}
\RequirePackage{etoolbox}
\usetikzlibrary{calc,positioning}

\mode<presentation>

%% ----------------------------------------------------------------------
%% Colour palette — clean Tailwind-derived indigo / blue with violet
%% accents and slate neutrals.  The indigo/violet/slate combo is the
%% widely-used "refined modern UI" trio (Linear, Stripe, Notion,
%% Figma): cool, slightly desaturated, blue-dominant with a subtle
%% purple bridge.  Blue carries primary structure, violet introduces
%% gentle variety on sub-elements, slate keeps text crisp and neutral.
\definecolor{DLUTBlue}{HTML}{4F46E5}    % indigo-600, primary accent
\definecolor{DLUTAzure}{HTML}{4338CA}   % indigo-700, structural deep
\definecolor{DLUTNavy}{HTML}{312E81}    % indigo-900, dark accent
\definecolor{DLUTDeep}{HTML}{1E1B4B}    % indigo-950, darkest
\definecolor{DLUTSteel}{HTML}{6366F1}   % indigo-500, title band — bridges blue & violet
\definecolor{DLUTBreeze}{HTML}{A5B4FC}  % indigo-300, pale indigo
\definecolor{DLUTViolet}{HTML}{8B5CF6}  % violet-500, purple accent
\definecolor{DLUTLavender}{HTML}{C4B5FD} % violet-300, soft purple
\definecolor{DLUTSky}{HTML}{EEF2FF}     % indigo-50, palest wash
\definecolor{DLUTMist}{HTML}{E0E7FF}    % indigo-100, soft wash
\definecolor{DLUTWarm}{HTML}{F5F3FF}    % violet-50, warm wash
\definecolor{DLUTLine}{HTML}{C7D2FE}    % indigo-200, subtle border
\definecolor{DLUTMuted}{HTML}{64748B}   % slate-500, neutral muted text
\definecolor{DLUTInk}{HTML}{0F172A}     % slate-900, near-black titles
\definecolor{DLUTBody}{HTML}{1E293B}    % slate-800, softened body text

%% Footer gradient segments — single-hue blue, left → right, light → dark
\colorlet{DLUTFootA}{DLUTBlue!15}
\colorlet{DLUTFootB}{DLUTBlue!30}
\colorlet{DLUTFootC}{DLUTBlue!50}
\colorlet{DLUTFootD}{DLUTBlue!75}

%% ----------------------------------------------------------------------
%% University logo and labels
\newcommand{\DLUTLogoPath}{assets/dlut-logo.pdf}
\newcommand{\SetDLUTLogoPath}[1]{\renewcommand{\DLUTLogoPath}{#1}}
\newcommand{\DLUTLogo}[1][1.2cm]{\includegraphics[width=#1]{\DLUTLogoPath}}

%% Secondary (white outline) logo for use on dark backgrounds.
%% A transparent PNG is shipped so the white strokes blend cleanly into
%% any dark fill — the source PDF includes an opaque white background.
\newcommand{\DLUTLogoWhitePath}{assets/dut-logo2-trimmed.png}
\newcommand{\SetDLUTLogoWhitePath}[1]{\renewcommand{\DLUTLogoWhitePath}{#1}}
\newcommand{\DLUTLogoWhite}[1][1.2cm]{\includegraphics[width=#1]{\DLUTLogoWhitePath}}

\newcommand{\DLUTDefenseLabel}{本科生毕业设计（论文）答辩}
\newcommand{\SetDLUTDefenseLabel}[1]{\renewcommand{\DLUTDefenseLabel}{#1}}
\newcommand{\DLUTTitleExtra}{}
\newcommand{\SetDLUTTitleExtra}[1]{\renewcommand{\DLUTTitleExtra}{#1}}

%% Section/subsection overview pages
\newif\ifDLUTSectionPages
\DLUTSectionPagestrue
\newcommand{\DLUTDisableSectionPages}{\DLUTSectionPagesfalse}
\newcommand{\DLUTEnableSectionPages}{\DLUTSectionPagestrue}
\newif\ifDLUTSubsectionPages
\DLUTSubsectionPagesfalse
\newcommand{\DLUTDisableSubsectionPages}{\DLUTSubsectionPagesfalse}
\newcommand{\DLUTEnableSubsectionPages}{\DLUTSubsectionPagestrue}

%% ----------------------------------------------------------------------
%% Minimal outer/inner themes
\useoutertheme{default}
\useinnertheme{circles}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{bibliography item}[text]

\setbeamersize{text margin left=.72cm,text margin right=.72cm}

%% ----------------------------------------------------------------------
%% Base colours — restrained, mostly ink/grey; blue used as accent only
\setbeamercolor{normal text}{fg=DLUTBody,bg=white}
\setbeamercolor{structure}{fg=DLUTAzure}
\setbeamercolor{alerted text}{fg=DLUTAzure}
\setbeamercolor{frametitle}{fg=DLUTInk,bg=white}
\setbeamercolor{title}{fg=DLUTInk}
\setbeamercolor{subtitle}{fg=DLUTMuted}

%% TOC colours
\setbeamercolor{section in toc}{fg=DLUTInk}
\setbeamercolor{section in toc shaded}{fg=DLUTMuted!58}
\setbeamercolor{subsection in toc}{fg=DLUTAzure}
\setbeamercolor{subsection in toc shaded}{fg=DLUTMuted!52}

%% Blocks — restrained: ink-coloured titles on a near-white tint, no
%% heavy filled bars.  Alert and example variants differ only in body
%% tint, keeping the page calm.
\setbeamercolor{block title}{fg=DLUTInk,bg=DLUTWarm}
\setbeamercolor{block body}{fg=DLUTBody,bg=DLUTWarm}
\setbeamercolor{block title alerted}{fg=DLUTAzure,bg=DLUTSky}
\setbeamercolor{block body alerted}{fg=DLUTBody,bg=DLUTSky}
\setbeamercolor{block title example}{fg=DLUTInk,bg=DLUTMist}
\setbeamercolor{block body example}{fg=DLUTBody,bg=DLUTMist}

%% Footer colours — four gradient cells
\setbeamercolor{footline cell a}{fg=DLUTDeep,bg=DLUTFootA}
\setbeamercolor{footline cell b}{fg=DLUTDeep,bg=DLUTFootB}
\setbeamercolor{footline cell c}{fg=white,bg=DLUTFootC}
\setbeamercolor{footline cell d}{fg=white,bg=DLUTFootD}

%% ----------------------------------------------------------------------
%% Fonts — restrained weights, generous line spacing, single body size.
%% Drawing inspiration from minimalist academic templates: titles are
%% not heavily bold, body uses a single size across itemise levels, and
%% ample leading lets content breathe.  We deliberately do not redefine
%% the family default so ctex/fandol Chinese fonts remain in charge.
\renewcommand{\baselinestretch}{1.25}

\setbeamerfont{title}{size=\large,series=\mdseries}
\setbeamerfont{subtitle}{size=\footnotesize,series=\mdseries}
\setbeamerfont{author}{size=\footnotesize,series=\mdseries}
\setbeamerfont{institute}{size=\scriptsize}
\setbeamerfont{date}{size=\scriptsize}
\setbeamerfont{frametitle}{size=\large,series=\mdseries}
\setbeamerfont{framesubtitle}{size=\scriptsize,series=\mdseries}
\setbeamerfont{block title}{size=\scriptsize,series=\bfseries}
\setbeamerfont{block body}{size=\scriptsize}
\setbeamerfont{block title alerted}{size=\scriptsize,series=\bfseries}
\setbeamerfont{block body alerted}{size=\scriptsize}
\setbeamerfont{block title example}{size=\scriptsize,series=\bfseries}
\setbeamerfont{block body example}{size=\scriptsize}
\setbeamerfont{itemize/enumerate body}{size=\scriptsize}
\setbeamerfont{itemize/enumerate subbody}{size=\scriptsize}
\setbeamerfont{itemize/enumerate subsubbody}{size=\scriptsize}
\setbeamerfont{footline}{size=\tiny}

%% List markers — small glossy spheres via TikZ ball color shading.
%% Itemize uses indigo, sub-items use violet to introduce the secondary
%% accent gently.  Enumerate keeps the filled-circle "badge" look but
%% smaller and sheen-shaded so it reads as a glass bead rather than a
%% solid UI button.
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{itemize item}{%
  \tikz[baseline=-.58ex]\shade[ball color=DLUTBlue] (0,0) circle (.36ex);%
}
\setbeamertemplate{itemize subitem}{%
  \tikz[baseline=-.50ex]\shade[ball color=DLUTViolet] (0,0) circle (.28ex);%
}
\setbeamertemplate{itemize subsubitem}{%
  \tikz[baseline=-.46ex]\draw[DLUTViolet,line width=.4pt] (0,0) circle (.24ex);%
}
\setbeamertemplate{enumerate item}{%
  \tikz[baseline=-.30ex]{%
    \shade[ball color=DLUTBlue] (0,0) circle (.95ex);%
    \node[inner sep=0pt] at (0,.02ex)
      {\fontsize{5}{6}\selectfont\color{white}\bfseries\insertenumlabel};%
  }%
}
\setbeamertemplate{enumerate subitem}{%
  \tikz[baseline=-.30ex]{%
    \shade[ball color=DLUTViolet] (0,0) circle (.85ex);%
    \node[inner sep=0pt] at (0,.02ex)
      {\fontsize{4.5}{5}\selectfont\color{white}\bfseries\insertsubenumlabel};%
  }%
}

%% Table of contents — refined glossy spheres carry the section
%% numbers.  Smaller than the default circles inner theme and shaded
%% for depth, so they read as glass beads rather than flat UI chips.
\makeatletter
\setbeamertemplate{section in toc}{%
  \leavevmode
  \hspace{.10cm}%
  \tikz[baseline=-.32ex]{%
    \shade[ball color=DLUTBlue] (0,0) circle (1.05ex);%
    \node[inner sep=0pt] at (0,.02ex)
      {\fontsize{5.5}{6}\selectfont\color{white}\bfseries\inserttocsectionnumber};%
  }%
  \hspace{.48cm}%
  {\fontsize{11}{14}\selectfont\color{DLUTInk}\inserttocsection}%
  \par\vspace{.28cm}
}
\setbeamertemplate{section in toc shaded}{%
  \leavevmode
  \hspace{.10cm}%
  \tikz[baseline=-.32ex]{%
    \shade[ball color=DLUTLine] (0,0) circle (1.05ex);%
    \node[inner sep=0pt] at (0,.02ex)
      {\fontsize{5.5}{6}\selectfont\color{DLUTMuted}\bfseries\inserttocsectionnumber};%
  }%
  \hspace{.48cm}%
  {\fontsize{11}{14}\selectfont\color{DLUTMuted!72}\inserttocsection}%
  \par\vspace{.28cm}
}
\setbeamertemplate{subsection in toc}{%
  \leavevmode
  \hspace{.85cm}%
  \tikz[baseline=-.42ex]\shade[ball color=DLUTViolet] (0,0) circle (.32ex);%
  \hspace{.45em}%
  {\fontsize{10}{12}\selectfont\color{DLUTMuted}\inserttocsubsection}%
  \par\vspace{.16cm}
}
\setbeamertemplate{subsection in toc shaded}{%
  \leavevmode
  \hspace{.85cm}%
  \tikz[baseline=-.42ex]\shade[ball color=DLUTLavender] (0,0) circle (.32ex);%
  \hspace{.45em}%
  {\fontsize{10}{12}\selectfont\color{DLUTMuted!55}\inserttocsubsection}%
  \par\vspace{.16cm}
}
\makeatother

%% ----------------------------------------------------------------------
%% Headline — empty (no top bar)
\setbeamertemplate{headline}{}

%% Frame title — plain coloured text, optional thin accent rule below.
%% Inspired by typographic Beamer themes (Argüelles / Pascal Michaillat):
%% no fill, no bold, the size and a hairline separator do the work.
\makeatletter
\setbeamertemplate{frametitle}{%
  \ifx\insertframetitle\@empty
  \else
    \nointerlineskip
    \vskip.65em
    \begin{beamercolorbox}[wd=\paperwidth,leftskip=.72cm,rightskip=.72cm]{frametitle}%
      \usebeamerfont{frametitle}\insertframetitle%
      \ifx\insertframesubtitle\@empty\else
        \quad{\usebeamerfont{framesubtitle}\color{DLUTMuted}\insertframesubtitle}%
      \fi\par
      \vskip-.45em
      {\color{DLUTLine}\rule{\dimexpr\paperwidth-1.44cm\relax}{.4pt}}\par
    \end{beamercolorbox}%
    \vskip.20em
  \fi
}
\makeatother

%% ----------------------------------------------------------------------
%% Footer — single-line, four cells with graduated blue tints
\makeatletter
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.30\paperwidth,ht=2.3ex,dp=1.0ex,leftskip=.72em,rightskip=.40em,center]{footline cell a}%
      \usebeamerfont{footline}\insertshortauthor%
      \ifx\insertshortinstitute\@empty\else\,(\insertshortinstitute)\fi%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.42\paperwidth,ht=2.3ex,dp=1.0ex,leftskip=.40em,rightskip=.40em,center]{footline cell b}%
      \usebeamerfont{footline}\insertshorttitle%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.18\paperwidth,ht=2.3ex,dp=1.0ex,leftskip=.40em,rightskip=.40em,center]{footline cell c}%
      \usebeamerfont{footline}\insertshortdate%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.10\paperwidth,ht=2.3ex,dp=1.0ex,center]{footline cell d}%
      \usebeamerfont{footline}\insertframenumber\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }\vskip0pt%
}
\makeatother

%% ----------------------------------------------------------------------
%% Title page — only the title sits inside the colour band, which uses
%% the new softer DLUTSteel.  No kicker (the defence label now lives in
%% \subtitle).  Institute and \DLUTTitleExtra share a single line so the
%% meta block stays tight and the colour seal can anchor the bottom
%% without overlapping the gradient footer.
\makeatletter
\defbeamertemplate*{title page}{dlut}{%
  \begin{tikzpicture}[remember picture,overlay]
    %% Title band: full-bleed horizontally, ~1.95cm tall, with ~1.00cm
    %% breathing room above it.  Lighter than the previous DLUTBlue
    %% band so it reads as a frame, not a slab.
    \fill[DLUTSteel]
      ($(current page.north west)+(0,-1.00cm)$) rectangle
      ($(current page.north east)+(0,-2.95cm)$);
    \node[anchor=center,align=center,inner sep=0pt] at
      ($(current page.north)+(0,-1.97cm)$) {%
        \begin{minipage}{.88\paperwidth}
          \centering
          {\usebeamerfont{title}\color{white}\inserttitle\par}
          \ifx\insertsubtitle\@empty\else
            \vspace{.16cm}
            {\usebeamerfont{subtitle}\color{white!85}\insertsubtitle\par}
          \fi
        \end{minipage}};
  \end{tikzpicture}%
  %% Flow content past the band — small gap, then meta block + logo.
  \vspace*{3.20cm}%
  \begin{center}
    \begin{minipage}{.88\paperwidth}
      \centering
      {\usebeamerfont{author}\color{DLUTInk}\insertauthor\par}
      \vspace{.18cm}
      {\usebeamerfont{institute}\color{DLUTMuted}\insertinstitute%
       \ifdefempty{\DLUTTitleExtra}{}{\hspace{.7em}·\hspace{.7em}\DLUTTitleExtra}\par}
      \vspace{.20cm}
      {\usebeamerfont{date}\color{DLUTMuted}\insertdate\par}
    \end{minipage}\par
    \vspace{.55cm}
    {\DLUTLogo[1.8cm]\par}
  \end{center}
}
\makeatother

%% ----------------------------------------------------------------------
%% Section overview frames
\newcommand{\DLUTSectionOverview}{%
  \begin{frame}{目录}
    \tableofcontents[
      currentsection,
      sectionstyle=show/shaded,
      subsectionstyle=show/shaded/hide,
      subsubsectionstyle=show/shaded/hide
    ]
  \end{frame}
}
\AtBeginSection[]{%
  \ifDLUTSectionPages
    \DLUTSectionOverview
  \fi
}
\AtBeginSubsection[]{%
  \ifDLUTSubsectionPages
    \DLUTSectionOverview
  \fi
}

%% ----------------------------------------------------------------------
%% Thank-you / closing frame — two-column composition.
%%   Left  : DLUTLine soft panel hosting the white-outline logo.
%%   Right : clean white space with stacked typographic text.
%% No deep-blue hero, no horizontal divider line.
\makeatletter
\newcommand{\DLUTThankYouPage}{%
  \begin{tikzpicture}[remember picture,overlay]
    %% Left soft panel: full-bleed, edge to edge (use \begin{frame}[plain]
    %% so the gradient footer is suppressed under the panel).
    \fill[DLUTLine]
      (current page.north west) rectangle
      ($(current page.south west)+(.42\paperwidth,0)$);
    %% Colour vector logo, centred in the panel (sharp at any size).
    \node[anchor=center,inner sep=0pt] at
      ($(current page.west)+(.21\paperwidth,0)$)
      {\DLUTLogo[4.0cm]};
    %% Right column: closing text, horizontally and vertically centred
    %% in the right white half.  Right-half centre x is at .71\paperwidth
    %% (i.e. .21\paperwidth right of page centre).
    \node[anchor=center,align=center,inner sep=0pt] at
      ($(current page.center)+(.21\paperwidth,0)$) {%
        \begin{minipage}{.50\paperwidth}
          \centering
          {\fontsize{24}{30}\selectfont\color{DLUTInk}感\,谢\,您\,的\,聆\,听\par}
          \vspace{.42cm}
          {\color{DLUTAzure}\rule{.75cm}{.5pt}\par}
          \vspace{.42cm}
          {\fontsize{14}{18}\selectfont\color{DLUTMuted}敬请各位老师批评指正\par}
        \end{minipage}%
      };
  \end{tikzpicture}%
}
\makeatother
